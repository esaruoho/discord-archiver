# Copy this file to .env and fill in your values.
# .env is git-ignored — your token never leaves your machine.

# Bot token from https://discord.com/developers/applications
# (Application → Bot → Token → Reset Token → Copy)
DISCORD_BOT_TOKEN=your-bot-token-here

# Channel ID to archive
# Enable Developer Mode in Discord (Settings → Advanced → Developer Mode),
# then right-click a channel → Copy Channel ID
DISCORD_CHANNEL_ID=000000000000000000

# Optional: where to write exports (default: ./exports)
# OUTPUT_DIR=./exports

# Optional: title shown at the top of the markdown changelog
# EXPORT_TITLE=Channel Archive
